root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Python is formatted by ruff (host/pyproject.toml).
[*.py]
indent_size = 4

# TypeScript, JSON, HTML and CSS are formatted by Prettier (extension/.prettierrc.json).
[*.{ts,js,mjs,json,html,css}]
indent_size = 2

[*.bat]
end_of_line = crlf

[*.md]
max_line_length = off
trim_trailing_whitespace = false
