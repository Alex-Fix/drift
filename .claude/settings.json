{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/doctor.sh)",
      "Bash(scripts/test.sh:*)",
      "Bash(scripts/lint.sh:*)",
      "Bash(npm ci)",
      "Bash(npm run build:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run format:*)",
      "Bash(npm test:*)",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run drift-host scan:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/*.pem)"
    ]
  }
}
